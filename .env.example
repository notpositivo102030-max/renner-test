# Copie para .env fora do webroot ou configure no ambiente/secret manager.
# Mantido como referência; o login administrativo exige ADMIN_USER e ADMIN_PASSWORD_HASH.
ADMIN_USER=mafia
ADMIN_PASSWORD_HASH=
APP_ENV=production
APP_FORCE_HTTPS=true

# Gere com: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_DATA_KEY=

# Caminho absoluto recomendado para SQLite fora do webroot em produção.
APP_DB_PATH=

# Diretório persistente recomendado para rate limit em produção multi-instância.
APP_RATE_LIMIT_DIR=

# Use true somente após homologar scripts/estilos externos com CSP em modo relatório.
APP_CSP_ENFORCE=false
