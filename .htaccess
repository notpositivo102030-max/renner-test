# Sprint 1 P0: deny direct HTTP access to local secrets and database artifacts.
# This is intentionally limited to server-side static-file protection and does
# not change application routes, fields, layout, schema, or persistence logic.
<FilesMatch "(?i)^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(bak|backup|log|sql|sqlite|sqlite3|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Deny direct access to VCS metadata, dependency manifests and local documentation
# when this repository root is served by Apache/LiteSpeed.
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

RedirectMatch 404 (?i)^/\.git(/|$)
